manifest {
    name            = 'auto16s'
    description     = '16S rRNA amplicon pipeline: FastQC, DADA2/SILVA, phyloseq, diversity, MaAsLin2, MultiQC'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=24.04.0'
    version         = '0.3.0'
}

params {
    // ---- required ----
    input         = null    // samplesheet.csv: sample,fastq_1,fastq_2,group[,metadata...]

    // ---- usually left as is ----
    group_col     = 'group'
    silva_db      = 'https://zenodo.org/records/4587955/files/silva_nr99_v138.1_train_set.fa.gz'
    outdir        = 'results'
    maaslin_reference = null    // reference group; default = alphabetically first
    fw_primer     = null        // only if your primers are not in assets/primers_16s.tsv
    rv_primer     = null
    trunc_len_f   = null        // null = automatic (quality + overlap check)
    trunc_len_r   = null
    rarefy_depth  = null        // null = automatic (see README)

    // ---- fixed defaults (literature standard) ----
    trunc_qmin    = 25          // truncate where median quality drops below this
    max_ee        = 2           // DADA2 maxEE for R1 and R2
    min_overlap   = 12          // mergePairs minOverlap (DADA2 default)
    min_boot      = 50          // assignTaxonomy bootstrap
    top_n         = 12          // taxa shown in bar plots
    permutations  = 999
    maaslin_min_prevalence = 0.1
    maaslin_qval  = 0.05
    seed          = 711

    // ---- infrastructure ----
    publish_dir_mode = 'copy'
    r_container   = 'ghcr.io/ozlemsagiroglu/auto16s-r:0.3.0'   // built by .github/workflows/r-image.yml
    max_cpus      = 8
    max_memory    = '32.GB'
    max_time      = '24.h'
    help          = false
}

process {
    shell  = ['/bin/bash', '-euo', 'pipefail']
    cpus   = { Math.min(1 * task.attempt, params.max_cpus as int) }
    memory = { [6.GB * task.attempt, params.max_memory as nextflow.util.MemoryUnit].min() }
    time   = { [4.h * task.attempt, params.max_time as nextflow.util.Duration].min() }

    errorStrategy = { task.exitStatus in ((130..145) + 104) ? 'retry' : 'finish' }
    maxRetries    = 1

    withLabel: 'process_single' { cpus = 1 }
    withLabel: 'process_low'    {
        cpus   = { Math.min(2, params.max_cpus as int) }
        memory = { [2.GB * task.attempt, params.max_memory as nextflow.util.MemoryUnit].min() }
    }
    withLabel: 'process_medium' {
        cpus   = { Math.min(4, params.max_cpus as int) }
        memory = { [12.GB * task.attempt, params.max_memory as nextflow.util.MemoryUnit].min() }
    }
    withLabel: 'process_high' {
        cpus   = { Math.min(8, params.max_cpus as int) }
        memory = { [24.GB * task.attempt, params.max_memory as nextflow.util.MemoryUnit].min() }
        time   = { [16.h * task.attempt, params.max_time as nextflow.util.Duration].min() }
    }
}

profiles {
    docker {
        docker.enabled    = true
        docker.runOptions = '-u $(id -u):$(id -g)'
        singularity.enabled = false
        conda.enabled       = false
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
        conda.enabled          = false
    }
    apptainer {
        apptainer.enabled    = true
        apptainer.autoMounts = true
        docker.enabled       = false
        conda.enabled        = false
    }
    conda {
        conda.enabled       = true
        conda.channels      = ['conda-forge', 'bioconda']
        conda.createTimeout = '2 h'     // the R environments take a while to solve the first time
        docker.enabled      = false
        singularity.enabled = false
    }
    test {
        // Real reads: DADA2's V4 example data (2x250) with 515F/806R primers added, 8 samples, 2 groups.
        // Regenerate with: Rscript tests/make_test_data.R tests/data
        params.input         = "${projectDir}/tests/data/samplesheet.csv"
        params.silva_db      = "${projectDir}/tests/data/example_train_set.fa.gz"
        params.max_cpus      = 2
        params.max_memory    = '4.GB'
    }
}

timeline { enabled = true; file = "${params.outdir}/pipeline_info/timeline.html"; overwrite = true }
report   { enabled = true; file = "${params.outdir}/pipeline_info/report.html";   overwrite = true }
trace    { enabled = true; file = "${params.outdir}/pipeline_info/trace.tsv";     overwrite = true }
dag      { enabled = true; file = "${params.outdir}/pipeline_info/dag.html";      overwrite = true }
